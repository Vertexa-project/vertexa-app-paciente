# Variáveis do client VERTEXA App Paciente — APENAS chave anon (nunca a chave de serviço).
# Copie para .env e preencha com os valores do projeto Supabase compartilhado.
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Paciente em modo demo (sem auth real): id do profile do paciente exibido no app.
# No seed = Mariana (...b1). Sob auth real isto vem de auth.uid().
VITE_DEMO_PATIENT_PROFILE_ID=00000000-0000-0000-0000-0000000000b1
# Profissional demo relacionado (usado por alguns fluxos de escrita).
VITE_DEMO_PROFESSIONAL_PROFILE_ID=00000000-0000-0000-0000-0000000000a2

# --- Observabilidade (Sentry) — OPCIONAL. Ver docs/OBSERVABILITY.md ---
# DSN público do projeto Sentry (browser). VAZIO/ausente = observabilidade DESLIGADA
# (no-op absoluto; o app roda idêntico). É o único segredo que pode ir ao bundle
# público (é um DSN de browser por design). NUNCA colocar chaves de servidor aqui.
VITE_SENTRY_DSN=
# Ambiente lógico reportado ao Sentry (ex.: production, staging, preview). Default: MODE do Vite.
VITE_APP_ENV=development
# Release (idealmente o commit SHA). Em CI/Vercel: VITE_APP_RELEASE=$VERCEL_GIT_COMMIT_SHA.
# Se vazio, o build injeta o SHA curto do git como fallback (ver vite.config.ts).
VITE_APP_RELEASE=
